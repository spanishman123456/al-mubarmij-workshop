{
  "name": "al-mubarmij-workshop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node scripts/start-dev-server.mjs",
    "dev:server:check": "node scripts/start-dev-server.mjs --check-only",
    "dev:server:raw": "node server/index.js",
    "build": "node scripts/validate-bingo-content.mjs && vite build",
    "validate:bingo": "node scripts/validate-bingo-content.mjs",
    "start": "node server/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:day04": "node scripts/run-playwright-env.mjs --days=4 --policy=open -- e2e/day04-qa.spec.js",
    "test:e2e:day05": "node scripts/run-playwright-env.mjs --days=5 --policy=open -- e2e/day05-qa.spec.js",
    "test:e2e:day06": "node scripts/run-playwright-env.mjs --days=6 --policy=open -- e2e/day06-qa.spec.js",
    "test:e2e:day07": "node scripts/run-playwright-env.mjs --days=7 --policy=open -- e2e/day07-qa.spec.js",
    "test:e2e:day08": "node scripts/run-playwright-env.mjs --days=8 --policy=open -- e2e/day08-qa.spec.js",
    "test:e2e:day09": "node scripts/run-playwright-env.mjs --days=9 --policy=open -- e2e/day09-qa.spec.js",
    "test:e2e:day01": "node scripts/run-playwright-env.mjs --days=1 --policy=open --grep \"onboarding\" -- e2e/platform.spec.js",
    "test:e2e:day02": "node scripts/run-playwright-env.mjs --days=2 --policy=open --grep \"day-02\" -- e2e/platform.spec.js",
    "test:e2e:python": "node scripts/run-playwright-env.mjs --days=9 --policy=sequential -- e2e/python-autocomplete.spec.js e2e/core-logic-audit.spec.js",
    "test:e2e:worksheets": "node scripts/run-playwright-env.mjs --days=9 --policy=sequential -- e2e/worksheets.spec.js",
    "test:e2e:teacher": "node scripts/run-playwright-env.mjs --days=4 --policy=sequential -- e2e/teacher-preview.spec.js e2e/core-logic-audit.spec.js",
    "test:e2e:days06-09-release": "node scripts/run-playwright-env.mjs --days=9 --policy=sequential -- e2e/days06-09-release.spec.js",
    "test:e2e:pilot": "node scripts/run-playwright-env.mjs --days=1 -- e2e/pilot-smoke.spec.js",
    "test:e2e:unlock": "node scripts/run-playwright-env.mjs --days=2 --vite-days=1 --policy=sequential -- e2e/day-unlock.spec.js",
    "hash:teacher-password": "node scripts/hash-teacher-password.mjs",
    "deploy:render-pilot": "node scripts/render-deploy-pilot.mjs",
    "extract:pdf-inventory": "python scripts/extract-pdf-inventory.py",
    "test:makecode-compile": "node scripts/compileMakecodeGames.mjs",
    "recalculate:progress": "node scripts/recalculate-progress.mjs",
    "recalculate:progress:remote": "node scripts/recalculate-progress-remote.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "framer-motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "makecode": "^1.3.5",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.4",
    "vitest": "^3.2.4"
  }
}
