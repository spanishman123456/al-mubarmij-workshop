# Copy to .env and fill values — never commit .env
NODE_ENV=development
PORT=3001

# Production (Render) — required
# NODE_ENV=production
# APP_URL=https://your-app.onrender.com
# ALLOWED_ORIGINS=https://your-app.onrender.com
# TEACHER_BCRYPT_HASH=<run: TEACHER_PASSWORD='...' npm run hash:teacher-password>
# PLATFORM_DB_PATH=/opt/render/project/src/server/data/platform.db
# APP_COMMIT_SHA=<git sha at deploy>
# REVOKE_TEACHER_SESSIONS=1

# Optional
# CONTENT_VERSION=student-pilot-batch-07
# BUILD_TIME=

# Local / CI tests only (gitignored .env.test.local)
# TEST_TEACHER_PASSWORD=<matches TEACHER_BCRYPT_HASH>
# E2E_TEACHER_PASSWORD=<same as deployed teacher password for staging e2e>
